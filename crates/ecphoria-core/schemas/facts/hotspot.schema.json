{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecphoria.dev/schemas/facts/hotspot.schema.json",
  "title": "hotspot",
  "description": "A file that changes often and breaks often. Subject: hotspot:<path>.",
  "type": "object",
  "required": ["path"],
  "properties": {
    "path": {"type": "string", "minLength": 1},
    "churn": {"description": "Commits touching the file in the observation window.", "type": "integer", "minimum": 0},
    "defects": {"type": "integer", "minimum": 0},
    "complexity": {"type": "number", "minimum": 0},
    "window_days": {"type": "integer", "minimum": 1}
  }
}
